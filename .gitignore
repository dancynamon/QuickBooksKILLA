# Rust
/target
crates/*/target
apps/*/target

# Node
node_modules/
dist/

# SQLite — the replica and its sidecars never belong in git
*.db
*.db-wal
*.db-shm

# Secrets. Tokens live in the OS keychain (DESIGN.md §5.1); nothing
# credential-shaped goes in the repo, and nothing goes anywhere Dropbox syncs.
.env
.env.*
tokens-*.json
*token*.json
*.pem
*.p12
secrets/
credentials/
.qbo-auth/

# Audit and rotation logs contain request payloads
audit-*.jsonl
rotation-*.jsonl

# OS
.DS_Store
