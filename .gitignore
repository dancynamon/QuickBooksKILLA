# Rust
/target
crates/*/target
apps/*/target

# Node
node_modules/
dist/

# SQLite — the replica and its sidecars never belong in git
*.db
*.db-wal
*.db-shm

# Secrets. Tokens live in the OS keychain (DESIGN.md §5.1); nothing
# credential-shaped goes in the repo, and nothing goes anywhere Dropbox syncs.
.env
.env.*
tokens-*.json
*token*.json
*.pem
*.p12
secrets/
credentials/
.qbo-auth/

# Audit and rotation logs contain request payloads
audit-*.jsonl
rotation-*.jsonl

# Everything pulled from the live book lives here and none of it is tracked.
# Snapshots carry customer names, balances and purchase-order numbers; a
# private repo is still permanent and may later be shared with a contractor.
# One ignored directory beats a list of filenames someone will forget to add to.
.local/

# OS
.DS_Store
