# Rust
/target
crates/*/target
apps/*/target

# Node
node_modules/
dist/

# SQLite — the replica and its sidecars never belong in git
*.db
*.db-wal
*.db-shm

# Secrets. Tokens live in the OS keychain (DESIGN.md §5.1); nothing
# credential-shaped goes in the repo, and nothing goes anywhere Dropbox syncs.
.env
.env.*
tokens-*.json
*token*.json
*.pem
*.p12
secrets/
credentials/
.qbo-auth/

# Audit and rotation logs contain request payloads
audit-*.jsonl
rotation-*.jsonl

# Real book data. Snapshots pulled from live QuickBooks carry customer names,
# balances and purchase-order numbers. A private repo is still permanent and
# may later be shared with a contractor; real financial data does not go in it.
live-snapshot.html
ar.json
inv.json
snapshot-*.html
*-live-*.json

# OS
.DS_Store
