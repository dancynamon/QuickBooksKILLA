{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BunzBooks",
  "version": "0.1.0",
  "identifier": "local.qbo-local.bunzbooks",
  "build": {
    "frontendDist": "../qbo-local/ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../qbo-local/ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../qbo-local/ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "BunzBooks", "width": 1400, "height": 900, "minWidth": 720, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Business"
  }
}
